@page
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authentication.OpenIdConnect
@model IndexModel

<div class="card shadow-sm">
    <div class="card-body">
        <p class="lead">Sign in through Keycloak. The realm should offer BankID as an identity provider.</p>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="alert alert-success">Welcome @User.Identity?.Name!</div>
            <p>Access token and refresh token are stored in the auth session for downstream API calls.</p>
            <div class="mb-2">
                <a class="btn btn-primary" href="/api">Call protected API</a>
                <a class="btn btn-outline-secondary" asp-page="/Logout">Logout</a>
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="Login">
                <button type="submit" class="btn btn-primary">Login with BankID via Keycloak</button>
            </form>
        }
    </div>
</div>

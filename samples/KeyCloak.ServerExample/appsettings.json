{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Keycloak": {
    "AuthServerUrl": "https://localhost:8080/realms/bankid",
    "Realm": "bankid",
    "ClientId": "bankid-server",
    "ClientSecret": "<client-secret>"
  },
  "BankId": {
    "Environment": "Simulated",
    "LicenseKey": "<bankid-license-key>",
    "UseSimulatedEnvironment": true
  }
}
